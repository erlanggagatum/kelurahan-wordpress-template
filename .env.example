# Copy to .env and fill in. .env is git-ignored.
# Local MySQL/MariaDB. Create the DB user first, see README.md.
DB_NAME=wp_agent
DB_USER=wp_agent
DB_PASSWORD=
DB_HOST=127.0.0.1:3306

# Site
WP_URL=http://localhost:8080
# Each site needs its own port (8080, 8081, …) to run side by side. Set it BEFORE setup.
WP_TITLE="Profil Kelurahan Dev"
WP_ADMIN_USER=admin
# Leave empty to auto-generate (printed once by setup).
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.test

# Folder name the theme is linked as inside .wp/wp-content/themes/
THEME_SLUG=kelurahan

# Privacy scan (bin/privacy-check.php): comma-separated terms that must never be
# committed — your real name, OS username, company/client names, hostnames.
# Case-insensitive substring match. Keep real values ONLY in .env.
PRIVACY_DENYLIST=
