{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "base-2", "name": "Base 2", "color": "#f4f4f5" },
				{ "slug": "contrast", "name": "Contrast", "color": "#18181b" },
				{ "slug": "contrast-2", "name": "Contrast 2", "color": "#52525b" },
				{ "slug": "accent", "name": "Accent", "color": "#2563eb" },
				{ "slug": "accent-2", "name": "Accent 2", "color": "#1e40af" },
				{ "slug": "border", "name": "Border", "color": "#e4e4e7" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(3.5rem, 8vw, 6rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|20",
			"padding": {
				"left": "var:preset|spacing|20",
				"right": "var:preset|spacing|20"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				":hover": { "color": { "text": "var:preset|color|accent-2" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"border": { "radius": "6px" },
				":hover": { "color": { "background": "var:preset|color|accent-2" } }
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": { "fontSize": "var:preset|font-size|xx-large" }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|contrast-2" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "post-meta", "title": "Post Meta", "area": "uncategorized" }
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without title",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-wide",
			"title": "Page (wide content)",
			"postTypes": [ "page", "post" ]
		}
	]
}
